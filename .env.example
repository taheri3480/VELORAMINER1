# Copy this file to .env on the VPS. Never commit the real .env file.
# DNS for this hostname must point to the VPS public IPv4.
DOMAIN=velora.example.com
APP_DOMAIN=velora.example.com

# Generate a long random password, e.g. `openssl rand -hex 32`.
DB_PASSWORD=replace_with_a_long_random_password

# Telegram bot token: rotate the old token with @BotFather before deployment.
TG_BOT_TOKEN=

# TON API key from TonAPI.
TONAPI_KEY=

# Random server-only secret (at least 24 characters), e.g. `openssl rand -hex 32`.
MEMO_SECRET=

# Comma-separated Telegram numeric IDs allowed to use admin actions.
ADMIN_TG_IDS=

# Keep wallet verification disabled until tested with a real wallet on testnet.
TON_PROOF_ENABLED=false

# Public app domain without https://.
# Keep payout signing disabled during initial VPS deployment and testnet validation.
# Do not put a main treasury recovery phrase here.
HOT_WALLET_MNEMONIC=

# Self-hosted defaults.
NITRO_PRESET=node-server
VITE_GROK_EXTENSIONS=0
VITE_AUTH_ENABLED=false
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
